{
  "name": "server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "ISC",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsc -p tsconfig.build.json && node --watch dist/server.js",
    "test": "vitest run",
    "lint": "eslint . && tsc --noEmit",
    "keygen": "tsc -p tsconfig.build.json && node dist/keygen.js"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "supertest": "^7.3.2",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
