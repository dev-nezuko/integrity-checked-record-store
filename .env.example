# Copy to .env. Leave both keys empty for a throwaway key that changes on every restart.
# Generate a pair with: docker compose run --rm app node dist/keygen.js
# (or `npm run keygen` inside server/). Never commit the private key.
RECORD_SIGNING_KEY=
VITE_RECORD_PUBLIC_KEY=

# true enables POST /api/record/tamper, which corrupts the latest version for demonstrations.
ALLOW_TAMPER_DEMO=false
